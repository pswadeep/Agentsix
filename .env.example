# ───────────────────────────────────────────────────────────────
# Multi-Agent Council — copy to .env and fill in.  cp .env.example .env
# Lines starting with # are comments. Never commit .env.
# An agent without a key is simply skipped, so you can start with a subset.
# ───────────────────────────────────────────────────────────────

# ── Shared secret between the localhost page and n8n (required)
# generate one with:  openssl rand -hex 24
WEBHOOK_SECRET=

# ── Telegram
# 1) talk to @BotFather → /newbot → paste the token below
# 2) start the stack, message your bot once: it replies with your chat id
# 3) put that id below (comma-separate several) and restart n8n
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# also send answers to prompts typed on the localhost page to the first chat id above
MIRROR_WEB_TO_TELEGRAM=true

# ── API keys (API keys, not chat-app logins — see README "About the keys")
ANTHROPIC_API_KEY_A=
ANTHROPIC_API_KEY_B=
OPENAI_API_KEY_A=
OPENAI_API_KEY_B=
GEMINI_API_KEY_A=
GEMINI_API_KEY_B=

# ── Models (override any time; defaults shown)
CLAUDE_A_MODEL=claude-sonnet-5-5
CLAUDE_B_MODEL=claude-haiku-5-5
CHATGPT_A_MODEL=gpt-6.1-terra
CHATGPT_B_MODEL=gpt-6-luna
GEMINI_A_MODEL=gemini-3.5-flash
GEMINI_B_MODEL=gemini-3.1-flash-lite

# ── Strategy (optional): who does what. First id is primary, the rest are failovers.
# MASTER_CHAIN=claude_a,claude_b,gemini_a,chatgpt_a,gemini_b,chatgpt_b
# ROLE_RESEARCH=gemini_a,gemini_b,claude_b,chatgpt_a
# ROLE_QUICK=gemini_b,gemini_a,chatgpt_b,claude_b
# ROLE_CODE=chatgpt_a,chatgpt_b,claude_b,gemini_a
# ROLE_WRITING=chatgpt_b,chatgpt_a,gemini_a,claude_b
# ROLE_ANALYSIS=claude_b,chatgpt_a,gemini_a,chatgpt_b
REVIEW_ENABLED=true
REVIEWER_AGENT=claude_b
# take an agent out of rotation without deleting its key, e.g. DISABLED_AGENTS=chatgpt_b
DISABLED_AGENTS=

# ── Limits
AGENT_TIMEOUT_MS=90000
WORKER_MAX_TOKENS=3000
COMBINE_MAX_TOKENS=3500

# ── Advanced (usually leave alone)
# internal address n8n uses to hand results to the localhost page
WEB_PUBLISH_URL=http://web:8080/api/publish
# use "chat" if you point OPENAI_BASE_URL at an OpenAI-compatible server that lacks /v1/responses
OPENAI_API_MODE=responses
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
